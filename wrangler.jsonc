{
  // Cloudflare Workers config. @astrojs/cloudflare fills in the rest (entry
  // point, static assets) and writes the final config to dist/server/wrangler.json.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personal-website-2024",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  }
}
