---
import type { GoodreadsBook } from '@/lib/goodreads'
import { resizeCover } from '@/lib/goodreads'

import FloatingMedia from '@/components/floating-media/floating-media.astro'

interface Props {
  books: GoodreadsBook[]
}

const { books } = Astro.props
const book = books[0]

const HEIGHT = 120

// Same feel as the /books hero: longer books get a thicker page block.
function bookThickness(pageCount: number, height: number): number {
  return Math.round(
    Math.min(30, Math.max(14, 10 + pageCount / 40)) * (height / 210)
  )
}
---
<style>
  .book {
    max-width: var(--content-width);
    margin: var(--padding-lg) auto 0;
    padding: var(--padding-lg);

    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--padding-lg);

    border: 1px solid var(--border-color);
    border-radius: 8px;
  }

  .media {
    flex-shrink: 0;
    display: block;
  }

  .media:focus-visible {
    outline: 2px solid var(--button-color);
    outline-offset: 4px;
    border-radius: 6px;
  }

  .details {
    min-width: 0;
  }

  .details a {
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--text-color);
    text-decoration: none;
  }

  .details a:hover {
    text-decoration: underline;
  }

  .author {
    display: block;
    font-size: var(--text-s);
    font-weight: 400;
    color: var(--text-accent-color);
  }

  .page-count {
    font-size: var(--text-xs);
    color: var(--text-accent-color);
    margin: var(--padding-xs) 0 0;
  }
</style>

<div class="book">
  <a
    class="media"
    href={book.link}
    aria-label={`${book.title} by ${book.author}`}
  >
    <FloatingMedia
      kind="book"
      image={resizeCover(book.imageUrl, 475)}
      title={book.title}
      height={HEIGHT}
      thickness={bookThickness(book.pageCount, HEIGHT)}
      stageHeight={HEIGHT + 16}
    />
  </a>
  <div class="details">
    <a href={book.link}>
      {book.title}
      <span class="author">{book.author}</span>
    </a>
    {book.pageCount > 0 && <p class="page-count">{book.pageCount} pages</p>}
  </div>
</div>
