---
import styles from './favorites.module.css'

import FancyLink from '../fancy-link/fancy-link.astro'
import FloatingMedia from '../floating-media/floating-media.astro'
import type { MediaKind } from '../floating-media/floating-media.astro'

interface Props {
  list: any[];
  kind?: MediaKind;
}

const { list, kind = 'book' } = Astro.props

const HEIGHTS: Record<MediaKind, number> = {
  book: 200,
  case: 210,
  game: 210,
  vinyl: 170,
}

const height = HEIGHTS[kind]
---
<ul class={styles.container}>
  {
    list.map((item: any) => (
      <li class={styles.item}>
        <a
          class={styles.media}
          href={item.hyperlink}
          aria-label={`${item.title}${item.subtitle ? ` by ${item.subtitle}` : ''}`}
        >
          <FloatingMedia
            kind={kind}
            image={item.image}
            title={item.title}
            height={height}
            stageHeight={height + 16}
          />
        </a>
        <FancyLink href={item.hyperlink} class={styles.title}>
          {item.title}
          {item.subtitle && <span class={styles.subtitle}>{item.subtitle}</span>}
        </FancyLink>
      </li>
    ))
  }
</ul>
