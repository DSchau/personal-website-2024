---
import { Image } from '@unpic/astro'
---
<style>
  .me {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  img {
    height: 40px;
    width: 40px;

    border-radius: var(--padding-md);

    margin: 0;
  }

  p {
    margin: 0;
    padding: 0;

    line-height: 1.35;
  }

  .name {
    font-weight: 600;
  }

  .role {
    color: color-mix(in srgb, var(--text-color) 60%, transparent);
  }
</style>

<div class="me">
  <Image src="https://dschau-website.imgix.net/me.jpeg" layout="fixed" height={40} width={40} background="auto" alt="Headshot portrait of Dustin Schau" />
  <div>
    <p class="name">Dustin Schau</p>
    <p class="role">Product & Engineering Leader</p>
  </div>
</div>
