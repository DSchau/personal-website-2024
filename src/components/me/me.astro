---
import { Image } from '@unpic/astro'
---
<style>
  .me {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  img {
    height: 24px;
    width: 24px;

    border-radius: 50%;

    margin: 0;
  }

  p {
    margin: 0;
    padding: 0;

    font-size: inherit;
    /* match the headshot height so the name stays centered on it while
       exposing a real text baseline for siblings to align to */
    line-height: 24px;
    align-self: baseline;
  }
</style>

<div class="me">
  <Image src="https://dschau-website.imgix.net/me.jpeg" layout="fixed" height={24} width={24} background="auto" alt="Headshot portrait of Dustin Schau" />
  <p>Dustin Schau</p>
</div>
