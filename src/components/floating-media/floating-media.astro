---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

export type MediaKind = "book" | "vinyl" | "case" | "game";

interface Props {
  /**
   * book: bound hardcover · vinyl: sleeve + record ·
   * case: Blu-ray keep case · game: console keep case
   */
  kind?: MediaKind;
  image?: string | ImageMetadata | null;
  title: string;
  /** Rendered height in px; width and thickness scale from it. */
  height: number;
  /** Y-rotation in degrees. Positive shows the spine, negative the fore-edge. */
  pose?: number;
  /** In-plane lean in degrees, like a product shot not quite squared up. */
  lean?: number;
  /** Depth of the object in px (book page block / case shell). */
  thickness?: number;
  /** Fixed stage height so differently sized pieces share a baseline. */
  stageHeight?: number;
  eager?: boolean;
}

// Width-to-height of the artwork itself. Cases wrap a plastic rim (and,
// for Blu-ray, the logo band) around it, so the box is sized from the art
// outward and the printed insert is never cropped.
const ART_ASPECTS: Record<MediaKind, number> = {
  book: 0.66,
  vinyl: 1,
  case: 0.675,
  game: 0.85,
};

const {
  kind = "book",
  image,
  title,
  height,
  pose: poseProp,
  lean: leanProp,
  thickness,
  stageHeight = height + 8,
  eager = false,
} = Astro.props;

function rand(min: number, max: number): number {
  return Math.round((min + Math.random() * (max - min)) * 10) / 10;
}

const isCase = kind === "case" || kind === "game";
// Random per-item variance keeps a row from feeling stamped out. These
// pages are prerendered, so positions re-roll on every build.
const maxPose = kind === "vinyl" ? 12 : 18;
const pose = poseProp ?? (Math.random() < 0.5 ? -1 : 1) * rand(6, maxPose);
const lean = leanProp ?? rand(-6, 6);
const h = height - Math.round(rand(0, height * 0.06));
// Local scans know their real proportions: a PS3 box is squatter than an
// Xbox 360 DVD case, and the case should follow the box it came from.
const artAspect =
  isCase && image && typeof image !== "string"
    ? Math.min(0.95, Math.max(0.6, image.width / image.height))
    : ART_ASPECTS[kind];
const rim = isCase ? Math.max(3, Math.round(h * 0.022)) : 0;
const banner = kind === "case" ? Math.round(h * 0.075) : 0;
const artH = h - rim * 2 - banner;
const w = isCase ? Math.round(artH * artAspect + rim * 2) : Math.round(h * artAspect);
const depth =
  thickness ??
  (kind === "book"
    ? Math.round(h * 0.1)
    : isCase
      ? Math.max(10, Math.round(h * 0.07))
      : 4);
const floatDelay = -rand(0, 5);
// local artwork is resized to 2x the rendered height and served as webp;
// the originals are full-size scans, far larger than the few hundred px shown
const src =
  typeof image === "string"
    ? image
    : image
      ? (await getImage({ src: image, height: Math.min(h * 2, image.height), format: "webp", layout: "none" })).src
      : "";
const hue = Math.floor(Math.random() * 360);
---

<span
  class:list={["stage", `kind-${kind}`]}
  style={`--stage-h: ${stageHeight}px; --mw: ${w}px; --mh: ${h}px; --d: ${depth}px; --pose: ${pose}deg; --lean: ${lean}deg; --float-delay: ${floatDelay}s; --hue: ${hue}; --rim: ${rim}px; --banner: ${banner}px;`}
>
  <span class="shadow" aria-hidden="true"></span>
  <span class="float">
    <span class="media-3d">
      {kind === "vinyl" && <span class="disc" aria-hidden="true"></span>}
      <span class="face back" aria-hidden="true"></span>
      {kind !== "vinyl" && (
        <span
          class="face spine"
          aria-hidden="true"
          style={src ? `background-image: url(${JSON.stringify(src)});` : undefined}
        />
      )}
      {kind === "book" && (
        <>
          <span class="face edge-top" aria-hidden="true"></span>
          <span class="face edge-fore" aria-hidden="true"></span>
        </>
      )}
      {isCase && (
        <>
          <span class="face side-top" aria-hidden="true"></span>
          <span class="face side-fore" aria-hidden="true"></span>
        </>
      )}
      <span class="face front">
        {kind === "case" && (
          <span class="bd-band" aria-hidden="true">
            <span class="bd-mark"></span>Blu-ray Disc
          </span>
        )}
        {src ? (
          <img
            src={src}
            alt=""
            width={isCase ? w - rim * 2 : w}
            height={isCase ? artH : h}
            loading={eager ? "eager" : "lazy"}
            decoding="async"
          />
        ) : (
          <span class="front-fallback">{title}</span>
        )}
      </span>
    </span>
  </span>
</span>

<style>
  .stage {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    height: var(--stage-h);
    perspective: 1400px;
  }

  .float {
    display: block;
    animation: levitate 7s ease-in-out infinite;
    animation-delay: var(--float-delay);
  }

  .media-3d {
    position: relative;
    display: block;
    width: var(--mw);
    height: var(--mh);
    transform-style: preserve-3d;
    transform-origin: 50% 90%;
    transform: rotate(var(--lean)) rotateY(var(--pose)) rotateX(4deg);
    transition: transform 0.6s var(--ease-fn);
    /* No will-change here: pinning a compositor layer makes Chrome skip
       re-rasterizing the face when a lazy-loaded cover finishes decoding,
       leaving random blank fronts. */
  }

  :global(a:hover) .media-3d,
  :global(a:focus-visible) .media-3d {
    transform: rotate(calc(var(--lean) * 0.25)) rotateY(calc(var(--pose) * 0.35))
      rotateX(2deg) translateZ(34px);
  }

  .face {
    position: absolute;
    display: block;
    backface-visibility: hidden;
  }

  /* ---------- front artwork ---------- */

  .front {
    inset: 0;
    overflow: hidden;
    background: #ece5d8;
    transform: translateZ(calc(var(--d) / 2));
    box-shadow: 0 0 0 1px rgba(48, 38, 24, 0.22);
  }

  .kind-book .front {
    border-radius: 0 2px 2px 0;
  }

  /* ---------- keep cases ----------
     A molded shell with a clear sleeve over the printed insert. The
     plastic shows as a thin rim around the art and, on Blu-ray, as the
     logo band across the top. Game scans already carry their platform
     banner, so they get only the rim. */
  .kind-case .front,
  .kind-game .front {
    padding: var(--rim);
    border-radius: 4px 9px 9px 4px;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.45),
      inset 0 0 0 1px rgba(255, 255, 255, 0.14);
  }

  .kind-game .front {
    background: linear-gradient(160deg, #3d4149 0%, #22252b 45%, #121417 100%);
  }

  .kind-case .front {
    padding-top: 0;
    background: linear-gradient(165deg, #4b96e4 0%, #2569c3 40%, #164b98 100%);
  }

  .bd-band {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(var(--banner) * 0.2);
    height: var(--banner);
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: calc(var(--banner) * 0.48);
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1;
    white-space: nowrap;
    color: #fff;
    text-shadow: 0 1px 1px rgba(0, 20, 60, 0.45);
  }

  /* The disc mark: a silver disc with the shell showing through the hub. */
  .bd-mark {
    flex: none;
    width: calc(var(--banner) * 0.58);
    height: calc(var(--banner) * 0.58);
    border-radius: 50%;
    background:
      radial-gradient(circle, #2569c3 0 17%, transparent 19%),
      conic-gradient(from 30deg, #f4f7fb, #b4c1d3, #ffffff, #9cadc4, #f4f7fb);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.55),
      0 1px 1px rgba(0, 20, 60, 0.4);
  }

  .kind-vinyl .front {
    border-radius: 1px;
  }

  .front img {
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: cover;
  }

  /* Heights come from --mh: percentage heights inside 3D faces are
     unreliable, and the art box is sized in px in the frontmatter. */
  .kind-case .front img,
  .kind-game .front img {
    display: block;
    height: calc(var(--mh) - var(--rim) * 2 - var(--banner));
    border-radius: 1px 3px 3px 1px;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.35);
  }

  .front::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
  }

  /* Hardcover: key light from the upper right, the hinge groove pressed
     into the board beside the spine, and a hairline catch-light where the
     board's cut edge meets the light. */
  .kind-book .front::after {
    background:
      linear-gradient(
        90deg,
        rgba(20, 12, 4, 0.36) 0,
        rgba(20, 12, 4, 0.1) calc(var(--mh) * 0.012),
        transparent calc(var(--mh) * 0.028),
        transparent calc(var(--mh) * 0.04),
        rgba(20, 12, 4, 0.24) calc(var(--mh) * 0.048),
        rgba(255, 255, 255, 0.28) calc(var(--mh) * 0.056),
        rgba(255, 255, 255, 0) calc(var(--mh) * 0.08)
      ),
      linear-gradient(
        250deg,
        rgba(255, 255, 255, 0.16) 0%,
        rgba(255, 255, 255, 0.04) 30%,
        transparent 55%,
        rgba(28, 20, 10, 0.14) 100%
      );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.32),
      inset -1px 0 0 rgba(255, 255, 255, 0.2),
      inset 0 -1px 0 rgba(0, 0, 0, 0.14);
  }

  .kind-case .front::after,
  .kind-game .front::after {
    background:
      /* hinge ribs molded into the sleeve beside the spine */
      linear-gradient(
        90deg,
        transparent calc(var(--mw) * 0.04),
        rgba(0, 0, 0, 0.22) calc(var(--mw) * 0.04),
        rgba(255, 255, 255, 0.16) calc(var(--mw) * 0.047),
        transparent calc(var(--mw) * 0.055)
      ),
      /* sheen on the clear sleeve */
      linear-gradient(
        112deg,
        transparent 30%,
        rgba(255, 255, 255, 0.2) 42%,
        rgba(255, 255, 255, 0.06) 50%,
        transparent 58%
      ),
      linear-gradient(
        250deg,
        rgba(255, 255, 255, 0.12) 0%,
        transparent 40%,
        rgba(0, 0, 0, 0.16) 100%
      );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      inset 0 0 calc(var(--rim) * 1.5) rgba(0, 0, 0, 0.22);
  }

  /* Sleeves are printed cardboard: flatter light, visible fold on the left. */
  .kind-vinyl .front::after {
    background: linear-gradient(
      255deg,
      rgba(255, 255, 255, 0.14) 0%,
      rgba(255, 255, 255, 0.04) 30%,
      rgba(0, 0, 0, 0.03) 60%,
      rgba(28, 20, 10, 0.14) 100%
    );
    box-shadow:
      inset 3px 0 4px -2px rgba(28, 20, 10, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .front-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 0.6rem;
    text-align: center;
    font-family: var(--header-font);
    font-size: 0.75rem;
    line-height: 1.3;
    color: #4a3a28;
    background: linear-gradient(160deg, #d8cdb6 0%, #c4b697 100%);
  }

  /* ---------- back / spine / edges ---------- */

  .back {
    inset: 0;
    background: linear-gradient(200deg, #383026 0%, #241e17 100%);
    transform: translateZ(calc(var(--d) / -2)) rotateY(180deg);
    box-shadow: 0 0 0 1px rgba(20, 14, 8, 0.6);
  }

  .kind-book .back {
    border-radius: 2px 0 0 2px;
  }

  .kind-case .back,
  .kind-game .back {
    border-radius: 9px 4px 4px 9px;
  }

  .kind-game .back {
    background: linear-gradient(200deg, #2b2e34 0%, #121417 100%);
  }

  .kind-case .back {
    background: linear-gradient(200deg, #2a6cc4 0%, #123f82 100%);
  }

  /* Case spines are rounded plastic over the insert's printed spine, so
     the art only shows through as a tint under cylinder shading. */
  .kind-case .spine,
  .kind-game .spine {
    border-radius: 4px 0 0 4px;
  }

  .kind-game .spine::after {
    background: linear-gradient(
      90deg,
      rgba(8, 9, 11, 0.9) 0%,
      rgba(60, 64, 72, 0.6) 30%,
      rgba(20, 22, 26, 0.7) 60%,
      rgba(4, 5, 6, 0.92) 100%
    );
  }

  .kind-case .spine::after {
    background: linear-gradient(
      90deg,
      rgba(10, 40, 100, 0.9) 0%,
      rgba(90, 160, 235, 0.6) 30%,
      rgba(30, 95, 185, 0.7) 60%,
      rgba(8, 30, 80, 0.92) 100%
    );
  }

  .kind-vinyl .back {
    border-radius: 1px;
    background: linear-gradient(200deg, #d9d0bd 0%, #bfb49c 100%);
  }

  /* The spine wears a stretched slice of the artwork so it matches. */
  .spine {
    top: 0;
    left: 0;
    width: var(--d);
    height: 100%;
    transform-origin: left center;
    transform: translateZ(calc(var(--d) / 2)) rotateY(-90deg);
    border-radius: 3px 0 0 3px;
    background-color: #383026;
    /* A heavily zoomed smear of the artwork: picks up the cover's palette
       without reading as a duplicated strip of the front. */
    background-size: 1100% 340%;
    background-position: 10% 32%;
  }

  /* Cylinder shading sells the rounded back of a bound spine: dark at
     both joints, a soft highlight a third of the way across. */
  .spine::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      90deg,
      rgba(15, 10, 5, 0.6) 0%,
      rgba(15, 10, 5, 0.18) 16%,
      rgba(255, 255, 255, 0.14) 36%,
      rgba(15, 10, 5, 0.12) 64%,
      rgba(15, 10, 5, 0.6) 100%
    );
  }

  /* Book page block, inset so the boards overhang it slightly. */
  .edge-fore {
    top: 3px;
    right: 1px;
    width: calc(var(--d) - 3px);
    height: calc(100% - 6px);
    transform-origin: right center;
    transform: translateZ(calc((var(--d) - 3px) / 2)) rotateY(90deg);
    background:
      repeating-linear-gradient(
        to bottom,
        rgba(150, 132, 100, 0.18) 0px,
        rgba(150, 132, 100, 0.18) 1px,
        transparent 1px,
        transparent 2px
      ),
      linear-gradient(90deg, #e6dcc6 0%, #faf6ec 30%, #f4eedf 80%, #ddd2ba 100%);
    box-shadow:
      inset 3px 0 3px -2px rgba(60, 45, 25, 0.45),
      inset -2px 0 2px -1px rgba(60, 45, 25, 0.3);
  }

  .edge-top {
    top: 1px;
    left: 4px;
    width: calc(100% - 6px);
    height: calc(var(--d) - 3px);
    transform-origin: top center;
    transform: translateZ(calc((var(--d) - 3px) / 2)) rotateX(90deg);
    background:
      repeating-linear-gradient(
        90deg,
        rgba(150, 132, 100, 0.16) 0px,
        rgba(150, 132, 100, 0.16) 1px,
        transparent 1px,
        transparent 2px
      ),
      linear-gradient(180deg, #fbf8ef 0%, #e8dfc9 100%);
    box-shadow: inset 0 2px 2px -1px rgba(60, 45, 25, 0.3);
  }

  /* Case shell sides: the same plastic as the rim. */
  .side-fore {
    top: 2px;
    right: 0;
    width: var(--d);
    height: calc(100% - 4px);
    transform-origin: right center;
    transform: translateZ(calc(var(--d) / 2)) rotateY(90deg);
  }

  .side-top {
    top: 0;
    left: 4px;
    width: calc(100% - 9px);
    height: var(--d);
    transform-origin: top center;
    transform: translateZ(calc(var(--d) / 2)) rotateX(90deg);
  }

  .kind-game .side-fore {
    background: linear-gradient(90deg, #2c2f35 0%, #3a3e46 50%, #15171a 100%);
  }

  .kind-game .side-top {
    background: linear-gradient(180deg, #4a4e57 0%, #2a2d33 50%, #17191c 100%);
  }

  .kind-case .side-fore {
    background: linear-gradient(90deg, #1d56a8 0%, #3a82d6 50%, #12407f 100%);
  }

  .kind-case .side-top {
    background: linear-gradient(180deg, #5aa2ea 0%, #2569c3 50%, #164b98 100%);
  }

  /* ---------- vinyl record ---------- */

  .disc {
    position: absolute;
    top: 4%;
    right: -16%;
    width: 92%;
    height: 92%;
    border-radius: 50%;
    transform: translateZ(-1px);
    transition: transform 0.8s var(--ease-fn);
    background:
      radial-gradient(
        circle at 50% 50%,
        #0c0c0c 0%,
        #0c0c0c 2.5%,
        #f3eee4 2.5%,
        #f3eee4 4%,
        hsl(var(--hue), 45%, 42%) 4%,
        hsl(var(--hue), 45%, 34%) 17%,
        hsl(var(--hue), 30%, 24%) 18%,
        transparent 18.5%
      ),
      conic-gradient(
        from 205deg,
        rgba(255, 255, 255, 0.14) 0deg,
        transparent 40deg,
        transparent 160deg,
        rgba(255, 255, 255, 0.1) 200deg,
        transparent 240deg
      ),
      repeating-radial-gradient(
        circle at 50% 50%,
        #0b0b0b 0px,
        #161616 1px,
        #0e0e0e 2px,
        #131313 3px
      );
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.65),
      6px 8px 18px -6px rgba(30, 22, 10, 0.5);
  }

  /* The record slips out and spins when you pick the sleeve up. */
  :global(a:hover) .disc,
  :global(a:focus-visible) .disc {
    transform: translateZ(-1px) translateX(14%) rotate(140deg);
  }

  /* ---------- shadow + motion ---------- */

  /* A tight contact shadow over a wide ambient one, so the piece reads as
     an object above the page rather than a sticker on it. */
  .shadow {
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: calc(var(--mw) * 1.4);
    height: calc(var(--mh) * 0.1);
    margin-left: calc(var(--mw) * -0.8);
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 36% 32% at 52% 50%,
        rgba(36, 26, 12, 0.34),
        transparent 100%
      ),
      radial-gradient(
        ellipse 50% 50% at 50% 50%,
        rgba(52, 40, 22, 0.24),
        rgba(52, 40, 22, 0.1) 55%,
        transparent 75%
      );
    filter: blur(5px);
    animation: shadow-breathe 7s ease-in-out infinite;
    animation-delay: var(--float-delay);
    transition: transform 0.6s var(--ease-fn), opacity 0.6s var(--ease-fn);
  }

  .kind-vinyl .shadow {
    width: calc(var(--mw) * 1.6);
    margin-left: calc(var(--mw) * -0.85);
  }

  :global(a:hover) > .stage .shadow,
  :global(a:focus-visible) > .stage .shadow {
    opacity: 0.55;
    transform: scale(0.92);
  }

  @keyframes levitate {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  @keyframes shadow-breathe {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(0.93);
      opacity: 0.75;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .float,
    .shadow {
      animation: none;
    }

    .media-3d,
    .shadow,
    .disc {
      transition: none;
    }

    :global(a:hover) .media-3d,
    :global(a:focus-visible) .media-3d {
      transform: rotate(var(--lean)) rotateY(var(--pose)) rotateX(4deg);
    }

    :global(a:hover) .disc,
    :global(a:focus-visible) .disc {
      transform: translateZ(-1px);
    }
  }
</style>
