---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

export type MediaKind = "book" | "vinyl" | "case" | "game";

interface Props {
  /**
   * book: bound hardcover · vinyl: sleeve + record ·
   * case: Blu-ray keep case · game: console keep case
   */
  kind?: MediaKind;
  image?: string | ImageMetadata | null;
  title: string;
  /** Rendered height in px; width and thickness scale from it. */
  height: number;
  /** Y-rotation in degrees. Positive shows the spine, negative the fore-edge. */
  pose?: number;
  /** In-plane lean in degrees, like a product shot not quite squared up. */
  lean?: number;
  /** Depth of the object in px (book page block / case shell). */
  thickness?: number;
  /** Fixed stage height so differently sized pieces share a baseline. */
  stageHeight?: number;
  eager?: boolean;
}

// Width-to-height of the artwork itself. Cases wrap a plastic rim (and,
// for Blu-ray, the logo band) around it, so the box is sized from the art
// outward and the printed insert is never cropped.
const ART_ASPECTS: Record<MediaKind, number> = {
  book: 0.66,
  vinyl: 1,
  case: 0.675,
  game: 0.85,
};

const {
  kind = "book",
  image,
  title,
  height,
  pose: poseProp,
  lean: leanProp,
  thickness,
  stageHeight = height + 8,
  eager = false,
} = Astro.props;

function rand(min: number, max: number): number {
  return Math.round((min + Math.random() * (max - min)) * 10) / 10;
}

const isCase = kind === "case" || kind === "game";
// Random per-item variance keeps a row from feeling stamped out. These
// pages are prerendered, so positions re-roll on every build.
const maxPose = kind === "vinyl" ? 12 : 18;
const pose = poseProp ?? (Math.random() < 0.5 ? -1 : 1) * rand(6, maxPose);
const lean = leanProp ?? rand(-6, 6);
const h = height - Math.round(rand(0, height * 0.06));
// Local scans know their real proportions: a PS3 box is squatter than an
// Xbox 360 DVD case, and the case should follow the box it came from.
const artAspect =
  isCase && image && typeof image !== "string"
    ? Math.min(0.95, Math.max(0.6, image.width / image.height))
    : ART_ASPECTS[kind];
// A Blu-ray case is a fixed 135 x 171.5 mm shell with a band of molded
// plastic across the top carrying the embossed logo; posters are cropped
// into the insert window like a real cover would be.
const isBluRay = kind === "case";
const rim = isCase ? Math.max(3, Math.round(h * (isBluRay ? 0.026 : 0.022))) : 0;
const band = isBluRay ? Math.round(h * 0.09) : 0;
const artH = h - rim * 2 - band + (isBluRay ? rim : 0);
const w = isBluRay
  ? Math.round(h * 0.787)
  : isCase
    ? Math.round(artH * artAspect + rim * 2)
    : Math.round(h * artAspect);
const depth =
  thickness ??
  (kind === "book"
    ? Math.round(h * 0.1)
    : isCase
      ? Math.max(10, Math.round(h * 0.07))
      : 4);
const floatDelay = -rand(0, 5);
// local artwork is resized to 2x the rendered height and served as webp;
// the originals are full-size scans, far larger than the few hundred px shown
const src =
  typeof image === "string"
    ? image
    : image
      ? (await getImage({ src: image, height: Math.min(h * 2, image.height), format: "webp", layout: "none" })).src
      : "";
const hue = Math.floor(Math.random() * 360);
---

<span
  class:list={["stage", `kind-${kind}`]}
  style={`--stage-h: ${stageHeight}px; --mw: ${w}px; --mh: ${h}px; --d: ${depth}px; --pose: ${pose}deg; --lean: ${lean}deg; --float-delay: ${floatDelay}s; --hue: ${hue}; --rim: ${rim}px; --band: ${band}px;`}
>
  <span class="shadow" aria-hidden="true"></span>
  <span class="float">
    <span class="media-3d">
      {kind === "vinyl" && <span class="disc" aria-hidden="true"></span>}
      <span class="face back" aria-hidden="true"></span>
      {kind !== "vinyl" && (
        <span
          class="face spine"
          aria-hidden="true"
          style={src ? `background-image: url(${JSON.stringify(src)});` : undefined}
        />
      )}
      {kind === "book" && (
        <>
          <span class="face edge-top" aria-hidden="true"></span>
          <span class="face edge-fore" aria-hidden="true"></span>
        </>
      )}
      {isCase && (
        <>
          <span class="face side-top" aria-hidden="true"></span>
          <span class="face side-fore" aria-hidden="true"></span>
        </>
      )}
      <span class="face front">
        {isBluRay && (
          <span class="bd-band" aria-hidden="true">
            <svg class="bd-logo" viewBox="-0.744 82.256 386 207" height={Math.round(band * 0.8)} fill="currentColor">
