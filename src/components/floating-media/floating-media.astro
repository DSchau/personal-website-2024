</span>

<style>
  .stage {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    height: var(--stage-h);
    perspective: 1400px;
  }

  .float {
    display: block;
    animation: levitate 7s ease-in-out infinite;
    animation-delay: var(--float-delay);
  }

  .media-3d {
    position: relative;
    display: block;
    width: var(--mw);
    height: var(--mh);
    transform-style: preserve-3d;
    transform-origin: 50% 90%;
    transform: rotate(var(--lean)) rotateY(var(--pose)) rotateX(4deg);
    transition: transform 0.6s var(--ease-fn);
    /* No will-change here: pinning a compositor layer makes Chrome skip
       re-rasterizing the face when a lazy-loaded cover finishes decoding,
       leaving random blank fronts. */
  }

  :global(a:hover) .media-3d,
  :global(a:focus-visible) .media-3d {
    transform: rotate(calc(var(--lean) * 0.25)) rotateY(calc(var(--pose) * 0.35))
      rotateX(2deg) translateZ(34px);
  }

  .face {
    position: absolute;
    display: block;
    backface-visibility: hidden;
  }

  /* ---------- front artwork ---------- */

  .front {
    inset: 0;
    overflow: hidden;
    background: #ece5d8;
    transform: translateZ(calc(var(--d) / 2));
    box-shadow: 0 0 0 1px rgba(48, 38, 24, 0.22);
  }

  .kind-book .front {
    border-radius: 0 2px 2px 0;
  }

  /* ---------- keep cases ----------
     A molded shell with a clear sleeve over the printed insert. The
     plastic shows as a thin rim around the art. */
  .kind-case .front,
  .kind-game .front {
    padding: var(--rim);
    border-radius: 4px 9px 9px 4px;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.45),
      inset 0 0 0 1px rgba(255, 255, 255, 0.14);
  }

  .kind-game .front {
    background: linear-gradient(160deg, #3d4149 0%, #22252b 45%, #121417 100%);
  }

  /* Blu-ray: saturated blue polypropylene, rim on three sides and the
     logo band across the top. */
  .kind-case .front {
    padding-top: 0;
    border-radius: 6px 11px 11px 6px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.22) 0, transparent var(--band)),
      linear-gradient(170deg, #3a8cf0 0%, #1a6ad8 38%, #0f55bd 100%);
  }

  .bd-band {
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--band);
  }

  /* Embossed, tone-on-tone: the logo is molded into the plastic, not printed. */
  .bd-logo {
    display: block;
    width: auto;
    color: rgba(190, 225, 255, 0.78);
    filter: drop-shadow(0 0.5px 0 rgba(4, 30, 90, 0.45));
  }

  .kind-vinyl .front {
    border-radius: 1px;
  }

  .front img {
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: cover;
  }

  /* Heights come from --mh: percentage heights inside 3D faces are
     unreliable, and the art box is sized in px in the frontmatter. */
  .kind-case .front img,
  .kind-game .front img {
    display: block;
    height: calc(var(--mh) - var(--rim) * 2);
    border-radius: 1px 3px 3px 1px;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.35);
  }

  .kind-case .front img {
    height: calc(var(--mh) - var(--rim) - var(--band));
    border-radius: 2px 4px 6px 2px;
    box-shadow: 0 0 0 1px rgba(4, 30, 90, 0.5);
    /* Posters are taller than the insert window; keep the top-weighted
       title treatments most one-sheets use. */
    object-position: 50% 22%;
  }

  .front::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
  }

  /* Hardcover: key light from the upper right, the hinge groove pressed
     into the board beside the spine, and a hairline catch-light where the
     board's cut edge meets the light. */
  .kind-book .front::after {
    background:
      linear-gradient(
        90deg,
