---
import type { CompletedRead } from "@/lib/goodreads";

interface Props {
  books: CompletedRead[];
}

const { books } = Astro.props;

const TILTS = [-24, 16, -8, 20, -18];

function spineWidth(pageCount: number): number {
  if (pageCount <= 0) {
    return 14;
  }
  return Math.round(Math.min(22, Math.max(10, 10 + pageCount / 70)));
}

function shortTitle(title: string): string {
  return title.replace(/\s+\(.*\)$/, "");
}
---

<section class="studio" aria-label="Five most recently finished books">
  <p class="eyebrow">Recently finished</p>
  <div class="shelf">
    {books.map((book, index) => (
      <a
        class="book"
        href={book.link}
        style={`--tilt: ${TILTS[index] ?? -12}deg; --spine: ${spineWidth(book.pageCount)}px;`}
        aria-label={`${shortTitle(book.title)} by ${book.author}`}
      >
        <span class="contact-shadow"></span>
        <span class="book-3d">
          <span class="top" aria-hidden="true"></span>
          <span class="spine" aria-hidden="true"></span>
          <span class="cover">
            {book.imageUrl ? (
              <img src={book.imageUrl} alt="" width="160" height="240" />
            ) : (
              <span class="cover-fallback">{shortTitle(book.title)}</span>
            )}
          </span>
          <span class="pages" aria-hidden="true"></span>
        </span>
        <span class="caption">
          <span class="caption-title">{shortTitle(book.title)}</span>
          <span class="caption-author">{book.author}</span>
        </span>
      </a>
    ))}
  </div>
</section>

<style>
  .studio {
    --studio-ink: #d8cfc3;
    --studio-muted: #9a9084;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    padding: 3rem 1.25rem 2.75rem;
    color: var(--studio-ink);
    background:
      radial-gradient(ellipse 70% 50% at 50% 0%, rgba(110, 82, 52, 0.2), transparent 58%),
      radial-gradient(ellipse 80% 36% at 50% 100%, rgba(0, 0, 0, 0.5), transparent 70%),
      #141210;
  }

  .eyebrow {
    margin: 0 auto 1.75rem;
    max-width: var(--content-width);
    text-align: center;
    font-size: var(--text-md);
    font-family: var(--body-font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--studio-muted);
  }

  .shelf {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: clamp(1.1rem, 3vw, 2.6rem);
    perspective: 1100px;
    perspective-origin: 50% 38%;
    overflow-x: auto;
    padding: 1.5rem 0.5rem 0.25rem;
    scrollbar-width: thin;
  }

  .book {
    position: relative;
    flex: 0 0 auto;
    width: clamp(92px, 16vw, 152px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: inherit;
  }

  .book-3d {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    transform-style: preserve-3d;
    transform: rotateY(var(--tilt)) rotateX(8deg);
    transition: transform 0.55s var(--ease-fn);
    will-change: transform;
  }

  .book:hover .book-3d,
  .book:focus-visible .book-3d {
    transform: rotateY(calc(var(--tilt) * 0.2)) rotateX(4deg) translateY(-10px);
  }

  .cover {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 2px 5px 5px 2px;
    background: #2a2420;
    box-shadow:
      inset 10px 0 14px rgba(0, 0, 0, 0.28),
      inset -2px 0 4px rgba(255, 255, 255, 0.06);
  }

  .cover img {
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: cover;
    filter: saturate(0.86) contrast(0.97) brightness(0.96);
  }

  .cover::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      108deg,
      rgba(0, 0, 0, 0.38) 0%,
      rgba(0, 0, 0, 0.14) 16%,
      rgba(255, 255, 255, 0.07) 40%,
      transparent 56%,
      rgba(0, 0, 0, 0.1) 100%
    );
  }

  .cover-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 0.75rem;
    text-align: center;
    font-family: var(--header-font);
    font-size: 0.85rem;
    line-height: 1.3;
    color: #e8dfd2;
  }

  .spine {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--spine);
    height: 100%;
    transform-origin: left center;
    transform: rotateY(-90deg);
    border-radius: 2px 0 0 2px;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.55) 0%, transparent 42%),
      linear-gradient(180deg, #3a322c 0%, #241e1a 48%, #1a1613 100%);
    box-shadow: inset -2px 0 3px rgba(255, 255, 255, 0.08);
  }

  .pages {
    position: absolute;
    top: 4px;
    right: 0;
    width: 11px;
    height: calc(100% - 8px);
    transform-origin: right center;
    transform: rotateY(90deg);
    background:
      repeating-linear-gradient(
        to bottom,
        #f4ebda 0px,
        #f4ebda 1px,
        #e4d8c2 1px,
        #e4d8c2 2px
      );
    box-shadow: inset 2px 0 3px rgba(80, 60, 30, 0.18);
  }

  .top {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--spine);
    transform-origin: top center;
    transform: rotateX(90deg);
    background: linear-gradient(180deg, #efe6d3 0%, #d8cdb6 100%);
    box-shadow: inset 0 -2px 3px rgba(80, 60, 30, 0.12);
  }

  .contact-shadow {
    position: absolute;
    left: 6%;
    right: -4%;
    bottom: 3.4rem;
    height: 22px;
    pointer-events: none;
    background: radial-gradient(ellipse, rgba(0, 0, 0, 0.55), transparent 72%);
    filter: blur(7px);
    transform: translateX(10px);
  }

  .caption {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    width: 100%;
    margin-top: 1.35rem;
    text-align: center;
  }

  .caption-title {
    font-family: var(--header-font);
    font-size: var(--text-s);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .caption-author {
    font-size: var(--text-xs);
    color: var(--studio-muted);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .book-3d {
      transition: none;
    }

    .book:hover .book-3d,
    .book:focus-visible .book-3d {
      transform: rotateY(var(--tilt)) rotateX(8deg);
    }
  }
</style>
