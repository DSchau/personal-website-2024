---
import type { CompletedRead } from "@/lib/goodreads";
import { resizeCover } from "@/lib/goodreads";
import FloatingMedia from "@/components/floating-media/floating-media.astro";

interface Props {
  books: CompletedRead[];
}

const { books } = Astro.props;

function bookThickness(pageCount: number, height: number): number {
  return Math.round(
    Math.min(30, Math.max(14, 10 + pageCount / 40)) * (height / 210)
  );
}

// faint engraved rules behind the books: the same broken "sky rules" as the page
// illustrations, densest through the middle (where the books sit), fading out at every edge
const RULES = (() => {
  let seed = 7
  const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647
  let out = ''
  for (let y = 6; y < 400; y += 7) {
    const t = 1 - Math.abs(y - 200) / 200 // 1 in the middle, 0 at the top + bottom
    let x = rnd() * 40, d = ''
    while (x < 1600) {
      const len = 40 + rnd() * 170
      d += `M${Math.round(x)} ${y}h${Math.round(len)}`
      x += len + 6 + rnd() * 34
    }
    out += `<path d="${d}" opacity="${(0.04 + t ** 1.5 * 0.16).toFixed(2)}"/>`
  }
  return out
})()

function shortTitle(title: string): string {
  return title.replace(/\s+\(.*\)$/, "");
}
---

<section class="press" aria-label="Six most recently finished books">
  <svg class="rules" viewBox="0 0 1600 400" preserveAspectRatio="none" aria-hidden="true" set:html={RULES} />
  <h3 class="section-title">Recently finished</h3>
  <div class="display-grid">
    {books.map((book) => (
      <a
        class="cell"
        href={book.link}
        aria-label={`${shortTitle(book.title)} by ${book.author}`}
      >
        <FloatingMedia
          kind="book"
          image={resizeCover(book.imageUrl, 475)}
          title={shortTitle(book.title)}
          height={212}
          thickness={bookThickness(book.pageCount, 212)}
          stageHeight={226}
          eager
        />
        <span class="caption">
          <span class="caption-title">{shortTitle(book.title)}</span>
          <span class="caption-author">{book.author}</span>
        </span>
      </a>
    ))}
  </div>
</section>

<style>
  /* plain paper, like the rest of the site; the engraved rules behind give it texture without a panel */
  .press {
    --press-muted: var(--text-accent-color);
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    padding: 0 1.5rem 2.25rem;
    color: var(--text-color);
  }

  .rules {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    fill: none;
    stroke: var(--text-color);
    stroke-width: 0.5;
    stroke-linecap: round;
    /* fade out at every edge, like the page illustrations */
    -webkit-mask-image:
      linear-gradient(to bottom, transparent, #000 20%, #000 80%, transparent),
      linear-gradient(to right, transparent, #000 15%, #000 85%, transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to bottom, transparent, #000 20%, #000 80%, transparent),
      linear-gradient(to right, transparent, #000 15%, #000 85%, transparent);
    mask-composite: intersect;
  }

  .rules :global(path) {
    vector-effect: non-scaling-stroke;
  }

  .press > :global(.section-title) {
    position: relative;
    margin-bottom: 2.25rem;
  }

  .display-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    row-gap: 3.25rem;
    column-gap: 0.5rem;
    position: relative;
    z-index: 1;
    max-width: 70rem;
    margin: 0 auto;
  }

  @media only screen and (min-width: 600px) {
    .display-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media only screen and (min-width: 1024px) {
    .display-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  .cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    text-decoration: none;
    color: inherit;
  }

  .cell:focus-visible {
    outline: 2px solid var(--button-color);
    outline-offset: 4px;
    border-radius: 6px;
  }

  .caption {
    display: flex;
    flex-direction: column;
    gap: 0.14rem;
    width: 100%;
    margin-top: 3.4rem;
    padding: 0 0.4rem;
    text-align: center;
  }

  .caption-title {
    font-family: var(--header-font);
    font-size: var(--text-md);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .caption-author {
    font-size: var(--text-s);
    color: var(--press-muted);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

</style>
