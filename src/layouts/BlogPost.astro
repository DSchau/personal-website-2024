---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

import Me from '@/components/me/me.astro';

import '@/styles/globals.css'
import styles from './blog-post.module.css'

interface Props {
  className?: string;
  frontmatter: CollectionEntry<'posts'>['data'] & {
    lastModified: string
  }
}

const { frontmatter } = Astro.props;

// short dates, matching the /posts list (e.g. "Jul 13, 2017")
const formatDate = (date: string | Date) => new Date(date).toLocaleDateString('en-us', { timeZone: 'UTC', month: 'short', day: 'numeric', year: 'numeric' })
const isoDate = (date: string | Date) => new Date(date).toISOString().slice(0, 10)
// compare calendar days (as displayed), so a same-day edit doesn't show a duplicate date
const shouldDisplayEdited = isoDate(frontmatter.lastModified) > isoDate(frontmatter.date)
---

<article class={styles.container}>
  <header class={styles.header}>
    {frontmatter.tags.length > 0 && <p class={styles.eyebrow}>{frontmatter.tags.map(tag => <span>{tag}</span>)}</p>}
    <h1 class={styles.title}>{frontmatter.title}</h1>
    {frontmatter.excerpt && <p class={styles.dek}>{frontmatter.excerpt}</p>}
    <div class={styles.meta}>
      <Me />
      <p class={styles.dates}>
        <span>Published <time datetime={isoDate(frontmatter.date)}>{formatDate(frontmatter.date)}</time></span>
        {shouldDisplayEdited && <span class={styles.updated}>Updated <time datetime={isoDate(frontmatter.lastModified)}>{formatDate(frontmatter.lastModified)}</time></span>}
      </p>
    </div>
  </header>
  {frontmatter.featuredImage && (
    <Image src={frontmatter.featuredImage} class={[styles.full, styles.hero].join(' ')} alt={"A preview for a blog post"} />
  )}
  <slot />
</article>

<style is:global>
  .medium-zoom-overlay {
    z-index: 9002;
  }
  .medium-zoom-image--opened {
    z-index: 9003;
    max-height: none !important;
    object-fit: contain !important;
  }
</style>

<script>
  import mediumZoom from 'medium-zoom';
  mediumZoom('article p > img', { margin: 24, background: 'rgba(0,0,0,0.8)' });
</script>

