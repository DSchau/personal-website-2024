---
import { Layout as LayoutComponent } from "@/components/layout/layout";
import { getCommitCount } from '@/lib/get-commit-count.ts';
import { getMostRecentCommit } from "@/lib/get-most-recent-commit";
import { getTotalCommitCount } from '@/lib/get-total-commit-count.ts';
import metayaml from '@/assets/meta.yaml'
import { marked } from 'marked'

const pathname = new URL(Astro.request.url).pathname.slice(1)

const gitHubArgs = {
	owner: 'dschau',
	repo: 'personal-website-2024'
}

const [commits, totalCommits, updated] = await Promise.all([
	getCommitCount(gitHubArgs, 0),
	getTotalCommitCount(gitHubArgs, 0),
	getMostRecentCommit(gitHubArgs, new Date())
])

const { title, description, showHeader, showCopy, copy, meta = [], byline, photo, display, scene } = Astro.props

// page copy may use light inline markdown (e.g. **bold**)
const copyHtml = copy ? (marked.parseInline(copy) as string) : undefined

// page-specific part first (search results truncate around 60 characters),
// brand last; the home page leads with the brand
const fullTitle = !title ? metayaml.title : pathname === '' ? `${metayaml.title} | ${title}` : `${title} | ${metayaml.title}`
const fullDescription = description ? description : metayaml.description
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		{pathname === '' && <link rel="preconnect" href="https://dschau-website.imgix.net" />}
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={fullDescription} />
		<meta property="og:description" content={fullDescription} />
		<meta name="twitter:description" content={fullDescription} />
		<meta name="keywords" content={metayaml.keywords} />
		<meta property="og:title" content={fullTitle} />
		<meta name="twitter:title" content={fullTitle} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={metayaml.title} />
		{
			meta.map(({ property, name, content }: any) => {
				return <meta property={property} name={name} content={content} />
			})
		}
		<title>{fullTitle}</title>
		<script defer data-domain="dustinschau.com" src="https://plausible.io/js/script.js"></script>
	</head>
	<body>
    <LayoutComponent pathname={pathname} commits={commits} totalCommits={totalCommits} updated={updated} showHeader={showHeader} showCopy={showCopy} copy={copyHtml} byline={byline} photo={photo} display={display} scene={scene}>
      <slot />
    </LayoutComponent>
    <script>
      import '@/components/footer/footer-interactions.ts'
      import '@/components/sea/ocean-motion.ts'
    </script>
	</body>
</html>