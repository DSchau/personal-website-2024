---
import Layout from '@/layouts/Layout.astro'
import PostList from '@/components/post-list/post-list.astro'
import { getPosts } from '@/lib/get-posts'

export const prerender = true

const posts = await getPosts()
---
<style>
  .container {
    margin: 0 auto;
    max-width: var(--content-width);

    padding: 0 var(--padding-lg);
  }

</style>

<Layout title="All posts" scene="writing" byline="Occasionally interesting content" copy={`Where I write about people, places, things, and ideas occasionally.`}>
  <div class="container">
    <h2 class="section-title">{posts.length} Post{posts.length > 1 ? 's' : ''}</h2>
    <PostList posts={posts} />
  </div>
</Layout>
