---
import { getCollection } from "astro:content";
import Layout from '@/layouts/Layout.astro'

export const prerender = true

const posts = await getCollection('posts', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
})
  .then((all) => {
    return all.sort((a, b) => {
      return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
    })
  })
---
<style>
  .container {
    --date-column: 7.25rem;
    --mono-font: ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, monospace;
    --hairline: color-mix(in srgb, var(--text-color) 18%, transparent);

    margin: 0 auto;
    max-width: var(--content-width);

    padding: 0 var(--padding-lg);
  }

  .smallcaps {
    font-family: var(--mono-font);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  ol {
    margin: var(--padding-lg) 0 0;
    border-top: 1px solid var(--hairline);
    padding: 0;
    list-style: none;
  }

  ol > li {
    margin: 0;
    padding: 0 0 var(--padding-md);
    border-bottom: 1px solid var(--hairline);
  }

  .link {
    display: grid;
    grid-template-columns: var(--date-column) 1fr;
    align-items: baseline;
    padding: var(--padding-md) 0 0;

    color: var(--text-color);
    text-decoration: none;
  }

  .date {
    display: flex;
    align-items: center;
    gap: var(--padding-md);
    font-variant-numeric: tabular-nums;
  }

  /* filled square for posts here, hollow for posts published elsewhere */
  .square {
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    background-color: var(--button-color);
    border: 1px solid var(--button-color);
  }

  .square.external {
    background-color: transparent;
  }

  .title {
    font-size: 1rem;
    line-height: 1.35;
    text-wrap: pretty;
  }

  .arrow {
    margin-left: var(--padding-s);
    opacity: 0.6;
  }

  .details {
    display: grid;
    grid-template-columns: var(--date-column) 1fr;
    align-items: baseline;
    row-gap: var(--padding-md);
    margin: 0;
    padding: var(--padding-md) 0 0;
  }

  .details dt {
    color: var(--text-accent-color);
  }

  .details dd {
    margin: 0;
  }

  .excerpt {
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--text-accent-color);
  }

  .subscribe {
    margin: var(--padding-lg) 0 0;
    text-align: center;
    font-size: var(--text-xs);
    color: color-mix(in srgb, var(--text-color) 55%, transparent);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--padding-s);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 1px 6px;
    border: 1px dotted color-mix(in srgb, var(--text-color) 45%, transparent);
    border-radius: 3px;
    color: var(--text-accent-color);
  }

  /* stack the date over the title on narrow screens */
  @media only screen and (max-width: 768px) {
    .link,
    .details {
      grid-template-columns: 1fr;
    }

    .link {
      row-gap: var(--padding-xs);
    }

    .details {
      row-gap: var(--padding-xs);
    }

    .details dd + dt {
      margin-top: var(--padding-md);
    }
  }
</style>

<Layout title="All posts" scene="writing" byline="Occasionally interesting content" copy={`Where I write about people, places, things, and ideas occasionally.`}>
  <div class="container">
    <h2 class="section-title">{posts.length} Post{posts.length > 1 ? 's' : ''}</h2>
    <ol reversed>
      {posts.map(post => {
        const href = post.data.canonicalLink ? post.data.canonicalLink : `/posts/${post.id}`
        const external = /https?/.test(href)
        const linkProps = external ? { target: '_blank', rel: 'noopener noreferrer' } : {}
        const date = new Date(post.data.date).toISOString().slice(0, 10)
        const hasDetails = Boolean(post.data.excerpt) || post.data.tags.length > 0
        return (
          <li>
            <a class="link" href={href} {...linkProps}>
              <span class="date smallcaps">
                <span class:list={['square', { external }]} aria-hidden="true" />
                <time datetime={date}>{date.replaceAll('-', '.')}</time>
              </span>
              <span class="title">
                {post.data.title}
                {external && (
                  <>
                    <span class="visually-hidden"> (opens in a new tab)</span>
                    <span class="arrow" aria-hidden="true">↗</span>
                  </>
                )}
              </span>
            </a>
            {hasDetails && (
              <dl class="details">
                {post.data.excerpt && (
                  <>
                    <dt class="smallcaps">Summary:</dt>
                    <dd><p class="excerpt">{post.data.excerpt}</p></dd>
                  </>
                )}
                {post.data.tags.length > 0 && (
                  <>
                    <dt class="smallcaps">Topics:</dt>
                    <dd>
                      <ul class="tags">
                        {post.data.tags.map(tag => <li class="smallcaps">{tag}</li>)}
                      </ul>
                    </dd>
                  </>
                )}
              </dl>
            )}
          </li>
        )
      })}
    </ol>
    <p class="subscribe">follow along via <a href="/rss.xml">rss</a></p>
  </div>
</Layout>

