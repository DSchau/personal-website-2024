---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro'
import { ogImageUrl } from '@/lib/og-image'
import { isRoutable } from '@/lib/post-visibility'

import MarkdownPostLayout from '@/layouts/BlogPost.astro';

export const prerender = true

export async function getStaticPaths() {
  const blogEntries = await getCollection('posts', ({ data }) => isRoutable(data, import.meta.env.PROD));
  return blogEntries.map(entry => ({
    params: { slug: entry.id }, props: { entry },
  }));
}

type Props = { entry: CollectionEntry<'posts'> }

const site = Astro.site
const { entry } = Astro.props

const { Content, remarkPluginFrontmatter } = await render(entry);

---

<style>
  :root {
    --main-padding: 0;
    --main-width: 100%;
  }

</style>

<Layout title={entry.data.title} description={entry.data.excerpt} showHeader={false} canonical={entry.data.canonicalLink} image={{
  url: ogImageUrl(site, { title: entry.data.title, tags: entry.data.tags, excerpt: entry.data.excerpt }),
  width: 1200,
  height: 620
}} meta={[
  {
    property: 'twitter:domain',
    content: site?.hostname.replace('www.', '')
  },
  {
    property: 'twitter:url',
    content: `${site?.href}posts/${entry.id}/`
  }
]}>
  <MarkdownPostLayout frontmatter={Object.assign({}, remarkPluginFrontmatter, entry.data) as any}>
    <Content />
  </MarkdownPostLayout>
</Layout>


