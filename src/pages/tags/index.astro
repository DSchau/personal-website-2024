---
import Layout from '@/layouts/Layout.astro'
import { getTags } from '@/lib/get-posts'

export const prerender = true

const tags = await getTags()
---
<style>
  .container {
    margin: 0 auto;
    max-width: var(--content-width);

    padding: 0 var(--padding-lg);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--padding-s) var(--padding-lg);

    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 0;
  }

  a {
    text-decoration: none;
  }

  a::before {
    content: '#';
    color: color-mix(in srgb, var(--text-color) 30%, transparent);
  }

  a:is(:hover, :focus-visible) {
    text-decoration: underline;
  }

  .count {
    margin-left: 0.2em;
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: color-mix(in srgb, var(--text-color) 50%, transparent);
  }
</style>

<Layout title="Tags" scene="writing" byline="Posts by topic" copy={`Everything I've written, grouped by what it's about.`}>
  <div class="container">
    <h2 class="section-title">{tags.length} Tags</h2>
    <ul>
      {tags.map(tag => (
        <li>
          <a href={`/tags/${tag.slug}/`}>{tag.label}</a><span class="count">{tag.posts.length}</span>
        </li>
      ))}
    </ul>
  </div>
</Layout>
