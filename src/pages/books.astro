---
import Layout from "@/layouts/Layout.astro";
import BookHero from "@/components/books/hero.astro";
import BooksList from "@/components/books/list.astro";
import { getCompletedReads, groupReadsByYear } from "@/lib/goodreads";

export const prerender = true;

const completed = await getCompletedReads();
const hero = completed.slice(0, 6);
const groups = groupReadsByYear(completed);
// Host-relative so preview deploys don't point og:image at production.
const ogImage = "/api/og.png?type=books";

const totalPages = completed.reduce((sum, book) => sum + book.pageCount, 0);
const busiest = groups.reduce(
  (best, group) => (group.books.length > (best?.books.length ?? 0) ? group : best),
  groups[0]
);
const firstYear = groups.length > 0 ? groups[groups.length - 1].year : null;
---

<style>
  :root {
    --main-width: min(72rem, 100%);
  }
</style>

<Layout
  title="Books"
  description="Books I've read and recently finished"
  byline="What I've been reading"
  copy="You can learn a lot about a person by what they read, so here's what I've been reading"
  meta={[
    { name: "twitter:card", content: "summary_large_image" },
    { property: "twitter:url", content: "/books" },
    { property: "og:image", content: ogImage },
    { name: "twitter:image", content: ogImage },
    { property: "og:image:width", content: "1200" },
    { property: "og:image:height", content: "630" },
  ]}
>
  {hero.length > 0 && <BookHero books={hero} />}

  {completed.length > 0 && (
    <p class="stats">
      <span class="stat">
        <strong>{completed.length.toLocaleString("en-US")}</strong> books
      </span>
      {totalPages > 0 && (
        <span class="stat">
          <strong>{totalPages.toLocaleString("en-US")}</strong> pages
        </span>
      )}
      {firstYear && (
        <span class="stat">
          reading since <strong>{firstYear}</strong><sup class="stat-note-mark">*</sup>
        </span>
      )}
      {busiest && (
        <span class="stat">
          busiest year <strong>{busiest.year}</strong> ({busiest.books.length})
        </span>
      )}
    </p>
  )}
  {firstYear && (
    <p class="stat-note">*Well... since I've been tracking them on Goodreads</p>
  )}

  {groups.length > 0 && (
    <section class="stacks">
      <BooksList groups={groups} total={completed.length} />
    </section>
  )}

  {completed.length === 0 && (
    <p class="empty">Couldn't load books from Goodreads right now.</p>
  )}
</Layout>

<style>
  .stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 1.75rem;
    row-gap: 0.4rem;
    margin: 1.75rem auto 0;
    padding: 0 var(--padding-lg);
    font-size: var(--text-s);
    color: var(--text-accent-color);
  }

  .stat strong {
    font-family: var(--header-font);
    font-weight: 400;
    font-size: var(--text-lg);
    color: var(--text-color);
  }

  .stat-note {
    margin: 0.35rem auto 0;
    padding: 0 var(--padding-lg);
    text-align: center;
    font-size: var(--text-xs);
    color: var(--text-accent-color);
  }

  .stacks {
    margin: 2rem auto var(--padding-xl);
    padding: 0 var(--padding-lg);
  }

  .empty {
    margin: var(--padding-xl) auto;
    max-width: var(--content-width);
    padding: 0 var(--padding-lg);
    text-align: center;
    color: var(--text-accent-color);
  }
</style>
