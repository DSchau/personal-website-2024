---
/**
 * Throwaway mock: header directions that echo the engraved footer.
 * Visit /mocks/header. Delete this folder once a direction is picked.
 */
import '@/styles/globals.css'
import './_header.css'
import { Navigation } from '@/components/navigation/navigation'
import { Header } from '@/components/header/header'
import {
  sun, lineHorizon, ridgeHatch, flock, rays, belowRidge, farRidge,
  glitter, swellLine, swellArea, rollingRows, crest, crestShade, band,
} from './_header-helpers'

export const prerender = false

const r = (n: number) => Math.round(n * 10) / 10

/* ---------- I+ : hills sunrise ---------- */
const ridge = lineHorizon(0, { bridge: false })
const below = belowRidge()
const P = { sunX: 1340, sunY: Math.round(farRidge(1340)) - 4, sunR: 34 }
const raysP = rays(P.sunX, P.sunY, P.sunR + 7, 32, 30, 14)
const sunP = sun(P.sunX, P.sunY, P.sunR, 2.8)
const hatchP = ridgeHatch(0, { lines: 5, seed: 9 })

/* ---------- shared sea sun ---------- */
const HZ = 182
const S = { x: 1300, y: HZ, r: 34 }
const seaRays = rays(S.x, S.y, S.r + 7, 32, 30, 14)
const seaSun = sun(S.x, S.y, S.r, 2.8)
const horizonD = swellLine(HZ, 1.4, 260)
const underSea = swellArea(HZ, 1.4, 260)
const glint = glitter(S.x, HZ, 236, 10)

/* ---------- W : Ocean Beach (bigger, more crests + shaded troughs) ---------- */
const seaW = rollingRows(HZ, 240, 9)
const crestSpots: [number, number, number][] = [
  [40, 232, 1.6], [330, 221, 1.1], [560, 236, 1.9], [820, 226, 1.25],
  [1060, 236, 1.8], [1200, 220, 1.0], [1470, 232, 1.6],
]
const crestsW = crestSpots.map(([x, y, sc], i) => ({ x, y, html: crestShade(x, y, sc, i + 3) + crest(x, y, sc) }))

/* ---------- W · Calm ---------- */
const seaCalm = rollingRows(HZ, 240, 8, 77)

/* ---------- W · Big swell ---------- */
const bump = (u: number) => Math.exp(-u * u)
// asymmetric swells: gentle back, steeper front (right)
const swellFn = (x: number) => {
  const sk = (c: number, w: number) => { const u = (x - c) / w; return u < 0 ? bump(u * 0.7) : bump(u * 1.5) }
  return 240 - 26 * sk(420, 170) - 34 * sk(980, 200) - 22 * sk(1480, 150) + Math.sin(x / 38) * 0.8
}
const bigSwell = band('swellBand', swellFn, { lines: 14, spacing: 2.4, base: 0.55, seed: 6, light: 1.6 })
const seaBehind = rollingRows(HZ, 216, 6, 19)
const bigCrests = [420, 980, 1480].map((cx, i) => {
  // crest sits just past each peak, on the steep front
  const sc = [1.7, 2.1, 1.5][i], x = cx - 37 * sc + 6, y = swellFn(cx) + 13 * sc
  return { x, y, html: crest(x, y, sc) }
})

/* ---------- W · Lands End (headland on the left) ---------- */
const cliffFn = (x: number) => {
  // asymmetric hump: long gentle back to the left, steep face to the right
  const c = 170, u = (x - c) / (x < c ? 360 : 190)
  const h = 46 * Math.exp(-(u * u) * (x < c ? 1 : 2.2))
  const rough = Math.sin(x / 31) * 1.6 + Math.sin(x / 11) * 0.6
  return HZ + 8 - h + rough * (h / 46)
}
const cliff = band('cliffBand', cliffFn, { lines: 16, spacing: 2.6, base: 0.6, from: -200, to: 620, seed: 12, light: 2.2, floor: HZ + 1 })
const seaLE = rollingRows(HZ, 240, 9, 55)
const crestsLE = ([[640, 232, 1.5], [900, 222, 1.0], [1460, 232, 1.5]] as [number, number, number][])
  .map(([x, y, sc], i) => ({ x, y, html: crestShade(x, y, sc, i + 9) + crest(x, y, sc) }))
// a little foam where the sea meets the cliff foot
let foam = ''
for (let i = 0; i < 5; i++) foam += `M${r(470 + i * 10)} ${r(HZ + 7 + i * 3.4)}h${r(18 + i * 7)}`
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Header mocks</title>
</head>
<body>
  <div class="col"><Navigation pathname="" /></div>

  <!-- I+ -->
  <div class="col"><p class="label"><strong>I+ · Sunrise over the hills</strong>. A faint sun with turning rays, half-risen behind A's horizon line; on hover it climbs and darkens. A loose flock flies over.</p></div>
  <section class="variant">
    <div class="col"><Header commits={58} /></div>
    <svg class="full stripFit ink" viewBox="0 86 1600 150" preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
      <g class="climb sunFaint"><g class="rise">
        <g class="rays" style={`transform-origin:${P.sunX}px ${P.sunY}px`}>
          <path class="raysA" d={raysP.a} stroke-width="1.2" />
          <path class="raysB" d={raysP.b} stroke-width=".8" />
        </g>
        <Fragment set:html={sunP} />
      </g></g>
      <path d={below} fill="#fefefe" stroke="none" />
      <Fragment set:html={ridge} />
      <Fragment set:html={hatchP} />
      <g class="flock" style="animation-delay:-20s"><Fragment set:html={flock(0, 156, 7, 21)} /></g>
      <g class="flock far" style="animation-delay:-48s"><Fragment set:html={flock(0, 142, 3, 5)} /></g>
    </svg>
  </section>

  <!-- W -->
  <div class="col"><p class="label"><strong>W · Ocean Beach</strong>. Bigger crests and more of them, each with an engraved shadow in the trough under its curl so the swells have volume. Rolling rows, glitter under the sun, and the flock overhead.</p></div>
  <section class="variant">
    <div class="col"><Header commits={58} /></div>
    <svg class="full stripFit ink" viewBox="0 86 1600 156" preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
      <g class="climb sunFaint"><g class="rise">
        <g class="rays" style={`transform-origin:${S.x}px ${S.y}px`}><path class="raysA" d={seaRays.a} stroke-width="1.2" /><path class="raysB" d={seaRays.b} stroke-width=".8" /></g>
        <Fragment set:html={seaSun} />
      </g></g>
      <g class="slide"><path d={underSea} fill="#fefefe" stroke="none" /><path d={horizonD} stroke-width=".8" /></g>
      <g opacity=".8">{seaW.map(row => <path class="roll" d={row.d} stroke-width={row.w} style={`animation-delay:${row.delay}s;animation-duration:${row.dur}s`} />)}</g>
      <g class="glitter">{glint.map(g => <path d={g.d} stroke-width=".9" style={`animation-delay:${g.delay}s`} />)}</g>
      {crestsW.map((c, i) => <g class="crest" style={`animation-delay:${-i * 1.3}s;transform-origin:${c.x + 34}px ${c.y}px`}><Fragment set:html={c.html} /></g>)}
      <g class="flock" style="animation-delay:-20s"><Fragment set:html={flock(0, 156, 7, 21)} /></g>
      <g class="flock far" style="animation-delay:-48s"><Fragment set:html={flock(0, 142, 3, 5)} /></g>
    </svg>
  </section>

  <!-- W · Calm -->
  <div class="col"><p class="label"><strong>W · Calm</strong>. The quietest sea: just the rolling rows and glitter, with no crests. Reads as early morning, flat water.</p></div>
  <section class="variant">
    <div class="col"><Header commits={58} /></div>
    <svg class="full stripFit ink" viewBox="0 86 1600 156" preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
      <g class="climb sunFaint"><g class="rise">
        <g class="rays" style={`transform-origin:${S.x}px ${S.y}px`}><path class="raysA" d={seaRays.a} stroke-width="1.2" /><path class="raysB" d={seaRays.b} stroke-width=".8" /></g>
        <Fragment set:html={seaSun} />
      </g></g>
      <g class="slide"><path d={underSea} fill="#fefefe" stroke="none" /><path d={horizonD} stroke-width=".8" /></g>
      <g opacity=".65">{seaCalm.map(row => <path class="roll" d={row.d} stroke-width={row.w} style={`animation-delay:${row.delay}s;animation-duration:${row.dur}s`} />)}</g>
      <g class="glitter">{glint.map(g => <path d={g.d} stroke-width=".9" style={`animation-delay:${g.delay}s`} />)}</g>
      <g class="flock" style="animation-delay:-20s"><Fragment set:html={flock(0, 156, 7, 21)} /></g>
      <g class="flock far" style="animation-delay:-48s"><Fragment set:html={flock(0, 142, 3, 5)} /></g>
    </svg>
  </section>

  <!-- W · Big swell -->
  <div class="col"><p class="label"><strong>W · Big swell</strong>. Three large swells in the foreground, engraved like the footer hills with heavier lines on the shadowed faces and a curling crest on each. Smaller water rolls behind them. The swells heave slowly.</p></div>
  <section class="variant">
    <div class="col"><Header commits={58} /></div>
    <svg class="full stripFit ink" viewBox="0 86 1600 156" preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
      <defs><Fragment set:html={bigSwell.clip} /></defs>
      <g class="climb sunFaint"><g class="rise">
        <g class="rays" style={`transform-origin:${S.x}px ${S.y}px`}><path class="raysA" d={seaRays.a} stroke-width="1.2" /><path class="raysB" d={seaRays.b} stroke-width=".8" /></g>
        <Fragment set:html={seaSun} />
      </g></g>
      <g class="slide"><path d={underSea} fill="#fefefe" stroke="none" /><path d={horizonD} stroke-width=".8" /></g>
      <g opacity=".7">{seaBehind.map(row => <path class="roll" d={row.d} stroke-width={row.w} style={`animation-delay:${row.delay}s;animation-duration:${row.dur}s`} />)}</g>
      <g class="glitter">{glint.slice(0, 6).map(g => <path d={g.d} stroke-width=".9" style={`animation-delay:${g.delay}s`} />)}</g>
      <g class="heave">
        <Fragment set:html={bigSwell.html} />
        {bigCrests.map((c, i) => <g class="crest" style={`animation-delay:${-i * 1.9}s;transform-origin:${c.x + 34}px ${c.y}px`}><Fragment set:html={c.html} /></g>)}
      </g>
      <g class="flock" style="animation-delay:-20s"><Fragment set:html={flock(0, 156, 7, 21)} /></g>
      <g class="flock far" style="animation-delay:-48s"><Fragment set:html={flock(0, 142, 3, 5)} /></g>
    </svg>
  </section>

  <!-- W · Lands End -->
  <div class="col"><p class="label"><strong>W · Lands End</strong>. Ocean Beach plus an engraved headland on the left that drops into the sea as a cliff, with a little foam at its foot. It's the most "San Francisco" without repeating the bridge.</p></div>
  <section class="variant">
    <div class="col"><Header commits={58} /></div>
    <svg class="full stripFit ink" viewBox="0 86 1600 156" preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
      <defs><Fragment set:html={cliff.clip} /></defs>
      <g class="climb sunFaint"><g class="rise">
        <g class="rays" style={`transform-origin:${S.x}px ${S.y}px`}><path class="raysA" d={seaRays.a} stroke-width="1.2" /><path class="raysB" d={seaRays.b} stroke-width=".8" /></g>
        <Fragment set:html={seaSun} />
      </g></g>
      <g class="slide"><path d={underSea} fill="#fefefe" stroke="none" /><path d={horizonD} stroke-width=".8" /></g>
      <g opacity=".8">{seaLE.map(row => <path class="roll" d={row.d} stroke-width={row.w} style={`animation-delay:${row.delay}s;animation-duration:${row.dur}s`} />)}</g>
      <g class="glitter">{glint.map(g => <path d={g.d} stroke-width=".9" style={`animation-delay:${g.delay}s`} />)}</g>
      <Fragment set:html={cliff.html} />
      <path class="foam" d={foam} stroke-width=".6" stroke-dasharray="10 3 4 3" />
      {crestsLE.map((c, i) => <g class="crest" style={`animation-delay:${-i * 1.6}s;transform-origin:${c.x + 34}px ${c.y}px`}><Fragment set:html={c.html} /></g>)}
      <g class="flock" style="animation-delay:-20s"><Fragment set:html={flock(0, 156, 7, 21)} /></g>
      <g class="flock far" style="animation-delay:-48s"><Fragment set:html={flock(0, 142, 3, 5)} /></g>
    </svg>
  </section>

  <div style="height: 4rem"></div>
</body>
</html>
