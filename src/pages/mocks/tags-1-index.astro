---
// MOCK 1: a back-of-the-book index
import Layout from '@/layouts/Layout.astro'
import { getTags } from '@/lib/get-posts'
import { postHref, shortTitle } from './_shared'

export const prerender = true

const tags = (await getTags()).sort((a, b) => a.label.localeCompare(b.label))
const letters = Map.groupBy(tags, tag => tag.label[0].toUpperCase())
---
<style>
  .container {
    margin: 0 auto;
    max-width: var(--content-width);
    padding: 0 var(--padding-lg);
  }

  .letter {
    margin: var(--padding-xl) 0 var(--padding-s);
    font-family: var(--header-font);
    font-size: 1.6rem;
    line-height: 1;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: var(--padding-s);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: var(--padding-s) 0;
  }

  .entry {
    display: flex;
    align-items: baseline;
    gap: var(--padding-s);
  }

  .entry a {
    color: inherit;
    text-decoration: none;
    font-weight: 500;
  }

  .entry a:is(:hover, :focus-visible) {
    text-decoration: underline;
  }

  .leader {
    flex: 1;
    border-bottom: 1px dotted color-mix(in srgb, var(--text-color) 35%, transparent);
    translate: 0 -0.25em;
  }

  .count {
    font-variant-numeric: tabular-nums;
    font-size: var(--text-s);
  }

  .see {
    margin: 0.1rem 0 0 var(--padding-lg);
    font-size: var(--text-xs);
    font-style: italic;
    color: color-mix(in srgb, var(--text-color) 60%, transparent);
  }

  .see a {
    color: inherit;
  }

  .see a:is(:hover, :focus-visible) {
    color: var(--text-color);
  }
</style>

<Layout title="Index" scene="writing" byline="Posts by topic" copy={`Everything I've written, indexed like the back of a book.`}>
  <div class="container">
    <h2 class="section-title">Index</h2>
    {[...letters].map(([letter, group]) => (
      <section>
        <h3 class="letter">{letter}</h3>
        <ul>
          {group.map(tag => (
            <li>
              <div class="entry">
                <a href={`/tags/${tag.slug}/`}>{tag.label}</a>
                <span class="leader" aria-hidden="true" />
                <span class="count">{tag.posts.length}</span>
              </div>
              <p class="see">
                {tag.posts.map((post, i) => <>{i > 0 && '; '}<a href={postHref(post)}>{shortTitle(post)}</a></>)}
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Layout>
